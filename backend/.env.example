# Biometrik yuz namunalarini shifrlash kaliti (bo'sh bo'lsa SECRET_KEY'dan hosil qilinadi).
# Yaratish: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
BIOMETRIC_KEY=

# Direktor Telegram boti (@BotFather → /newbot)
TELEGRAM_BOT_TOKEN=

# Birinchi direktor akkaunti (bo'sh bo'lsa start paytida so'raladi)
