# SchoolPro sozlamalari — nusxa oling: cp .env.example .env
SECRET_KEY=bu-yerga-uzun-tasodifiy-satr-yozing
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1
# Ishlab chiqarishda domen: https://schoolpro.uz
